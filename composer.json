{
    "name": "naomai/compactorium",
    "require": {
        "delight-im/auth": "^9.0",
        "vlucas/phpdotenv": "^5.6",
        "symfony/var-exporter": "^7.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/flex": "^2.11",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "symfony/dotenv": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Naomai\\Compactorium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "naomai",
            "email": "lulu@nieznani-sprawcy.pl"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "13"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
